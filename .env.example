# ===========================================================================
# DHF GDP Checker - Environment Configuration
# Copy this file to ".env" and fill in your real values.
# Never commit .env to source control.
# ===========================================================================

# ---- Azure OpenAI (preferred for production) -------------------------------
AZURE_OPENAI_ENDPOINT=https://doc-gen.services.ai.azure.com/
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_PRIMARY=gpt-5.1
AZURE_OPENAI_DEPLOYMENT_SECONDARY=gpt-5

# ---- Optional: plain OpenAI fallback ---------------------------------------
OPENAI_API_KEY=

# ---- Service ports ---------------------------------------------------------
AGENTIC_API_PORT=5003
FRONTEND_PORT=5000

# ---- Misc ------------------------------------------------------------------
BRAND=Philips
LOG_LEVEL=INFO
# Comma-separated list of allowed origins for CORS (use * only for dev)
CORS_ALLOWED_ORIGINS=*
# Folder where session artefacts (uploaded docs, drafts, final outputs) live
WORKSPACE_DIR=./.agent_workspace

# ---- Authentication (LDAP / Active Directory) ------------------------------
# Set AUTH_ENABLED=0 to disable login entirely (local dev only).
AUTH_ENABLED=1
LDAP_SERVER=161.85.28.34
LDAP_PORT=389
LDAP_BASE=DC=code1,DC=emi,DC=philips,DC=com
# Session lifetime (seconds) for the login cookie + server-side session.
SESSION_EXPIRE_SECONDS=3600
# Set to 1 when serving over HTTPS so cookies are only sent over TLS.
SESSION_COOKIE_SECURE=0
# Use "none" (with SESSION_COOKIE_SECURE=1) when frontend/backend are on
# different sites; "lax" is fine for same-site (e.g. localhost) deployments.
SESSION_COOKIE_SAMESITE=lax

# ---- Session store (Redis) -------------------------------------------------
# In docker-compose this is overridden to the "redis" service host.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0


# ---- Performance tuning ----------------------------------------------------
# Timeout for a single Azure OpenAI request (seconds). Lower = fail fast.
# 45 s is a good default. If you use a slow reasoning model (gpt-5.1) raise to 90.
AI_REQUEST_TIMEOUT=45
# Hard wall-clock budget for the whole "run AI checks" stage (seconds).
# Stuck checks beyond this point are abandoned and reported as errors.
AGENT_PER_CHECK_TIMEOUT=120
# Fast mode: auto-skip the 5 known-slow checks (template-compliance, acronyms,
# spelling, risky-modals, brand-casing). Set to 1 for snappy interactive runs.
AGENT_FAST_MODE=0
